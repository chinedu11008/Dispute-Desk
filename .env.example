# MODE=SIMULATED runs fully offline. LIVE_SANDBOX talks to PayPal's sandbox (never production).
MODE=SIMULATED
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# PayPal sandbox app credentials (developer dashboard > Sandbox > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# LLM provider: heuristic (offline, deterministic) or claude
LLM=heuristic
ANTHROPIC_API_KEY=
CLAUDE_FAST_MODEL=claude-haiku-5-5
CLAUDE_SMART_MODEL=claude-sonnet-5-5
# LLM cache: off | record | replay (replay needs no API key)
LLM_CACHE=off
